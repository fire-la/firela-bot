#!/bin/sh

# Pre-commit hook - Fast checks only (no tests)
# Tests run in pre-push for full CI validation
echo "🚀 Running pre-commit checks..."

# Check for Chinese characters in staged code files
echo "🔍 Checking for Chinese characters in code..."
staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|yaml|yml)$' | grep -v '/i18n/' | grep -v '/src/parsers/fixtures/' || true)

if [ -n "$staged_files" ]; then
  chinese_files=""
  for file in $staged_files; do
    if [ -f "$file" ]; then
      if perl -C -ne 'exit 1 if /\p{Han}/' "$file" 2>/dev/null; then
        : # no Chinese
      else
        chinese_files="$chinese_files
  $file"
      fi
    fi
  done

  if [ -n "$chinese_files" ]; then
    echo "❌ Chinese characters detected in code files:"
    echo "$chinese_files"
    echo ""
    echo "Code comments, variable names, and strings must be in English."
    echo "User-facing text should use i18n framework for localization."
    exit 1
  fi
fi

echo "✅ No Chinese characters in code files"

# Run lint on all packages (fast)
echo "🔧 Running linter..."
pnpm -r --filter './packages/**' run lint || exit 1

# Run format check
# NOTE: Format check disabled due to oxfmt bug with type guard return types
# https://github.com/oxc-project/oxc/issues/...
# The formatter strips `event is TransactionEvent` to just `{`
# echo "🎨 Checking code formatting..."
# pnpm -r --filter './packages/**' run format || exit 1

echo "✅ All pre-commit checks passed!"
